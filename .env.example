# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real keys.
#
# Every variable here is OPTIONAL. With none of them set, the app still works
# end to end: it reads labels on-device with Tesseract and judges them with the
# local rule engine. These only switch on the faster online reader.

# The deployed Supabase Edge Function that reads labels with Gemini.
# Leave blank to always use on-device OCR.
VITE_EXTRACT_URL=

# Your Supabase project's anon key. Safe to ship in a client build: it only
# permits calling the function, and the Gemini key stays server-side.
VITE_SUPABASE_ANON_KEY=

# Shown in Profile so a tester can say which build they are on.
VITE_BUILD_ID=local
