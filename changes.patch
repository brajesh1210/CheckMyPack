diff --git a/src/components/IndiaMap.tsx b/src/components/IndiaMap.tsx
new file mode 100644
index 0000000..199e5ff
--- /dev/null
+++ b/src/components/IndiaMap.tsx
@@ -0,0 +1,139 @@
+import { useState } from 'react'
+
+export interface MapCluster {
+  id: string
+  name: string
+  state: string
+  violations: number
+  tier: 'high' | 'medium' | 'low'
+  x: number
+  y: number
+}
+
+const DEFAULT_CLUSTERS: MapCluster[] = [
+  { id: 'mum', name: 'Mumbai', state: 'Maharashtra', violations: 132, tier: 'high', x: 27, y: 55 },
+  { id: 'del', name: 'Dwarka (Delhi)', state: 'Delhi NCR', violations: 84, tier: 'medium', x: 38, y: 26 },
+  { id: 'raj', name: 'Rajkot', state: 'Gujarat', violations: 74, tier: 'medium', x: 20, y: 46 },
+  { id: 'pune', name: 'Pune', state: 'Maharashtra', violations: 58, tier: 'medium', x: 30, y: 59 },
+  { id: 'blr', name: 'Bengaluru', state: 'Karnataka', violations: 42, tier: 'low', x: 39, y: 76 },
+  { id: 'kol', name: 'Kolkata', state: 'West Bengal', violations: 29, tier: 'low', x: 74, y: 45 },
+  { id: 'chn', name: 'Chennai', state: 'Tamil Nadu', violations: 36, tier: 'low', x: 47, y: 80 },
+  { id: 'hyd', name: 'Hyderabad', state: 'Telangana', violations: 24, tier: 'low', x: 43, y: 62 },
+]
+
+export function IndiaMap({
+  mode = 'india',
+  onSelectCluster,
+}: {
+  mode?: 'india' | 'states'
+  onSelectCluster?: (cluster: MapCluster) => void
+}) {
+  const [selected, setSelected] = useState<MapCluster | null>(DEFAULT_CLUSTERS[0])
+
+  const handlePick = (c: MapCluster) => {
+    setSelected(c)
+    onSelectCluster?.(c)
+  }
+
+  return (
+    <div className="relative w-full overflow-hidden rounded-2xl border border-ink-200/80 bg-info-soft p-3 shadow-inner">
+      <svg
+        viewBox="0 0 100 115"
+        className="block h-auto w-full select-none"
+        role="img"
+        aria-label="Interactive map of India with violation hotspots"
+      >
+        <defs>
+          <radialGradient id="heat-high" cx="50%" cy="50%" r="50%">
+            <stop offset="0%" stopColor="var(--cmp-bad)" stopOpacity="0.85" />
+            <stop offset="40%" stopColor="var(--cmp-warn)" stopOpacity="0.55" />
+            <stop offset="100%" stopColor="var(--cmp-warn)" stopOpacity="0" />
+          </radialGradient>
+
+          <radialGradient id="heat-med" cx="50%" cy="50%" r="50%">
+            <stop offset="0%" stopColor="var(--cmp-warn)" stopOpacity="0.75" />
+            <stop offset="60%" stopColor="var(--cmp-warn)" stopOpacity="0.3" />
+            <stop offset="100%" stopColor="var(--cmp-warn)" stopOpacity="0" />
+          </radialGradient>
+
+          <radialGradient id="heat-low" cx="50%" cy="50%" r="50%">
+            <stop offset="0%" stopColor="var(--cmp-ok)" stopOpacity="0.65" />
+            <stop offset="60%" stopColor="var(--cmp-ok)" stopOpacity="0.25" />
+            <stop offset="100%" stopColor="var(--cmp-ok)" stopOpacity="0" />
+          </radialGradient>
+
+          <filter id="glow-blur" x="-50%" y="-50%" width="200%" height="200%">
+            <feGaussianBlur in="SourceGraphic" stdDeviation="1.8" />
+          </filter>
+        </defs>
+
+        {/* Realistic India Silhouette Path */}
+        <path
+          d="M 38 6 
+             L 45 4 L 49 8 L 52 14 L 56 16 L 61 14 L 64 18 L 62 23 L 68 25 L 75 22 L 80 26 L 86 28 L 91 35 L 89 42 L 83 45 L 80 52 L 75 52 L 72 58 L 66 65 L 61 74 L 54 86 L 49 104 L 44 95 L 39 84 L 34 76 L 28 68 L 22 58 L 16 48 L 14 38 L 18 30 L 25 24 L 29 16 Z"
+          fill="var(--cmp-map-fill)"
+          stroke="var(--cmp-map-line)"
+          strokeWidth="0.8"
+          strokeLinejoin="round"
+        />
+
+        {/* State border subdivisions */}
+        <path
+          d="M 28 35 Q 38 38 48 36 M 22 48 Q 35 52 50 50 M 34 60 Q 45 62 60 58 M 38 72 Q 46 75 54 74 M 64 35 L 72 45 M 50 20 L 56 32"
+          fill="none"
+          stroke="var(--cmp-map-line)"
+          strokeWidth="0.5"
+          strokeDasharray="1.5 1.5"
+        />
+
+        {/* Heatmap Halos / Radiance Layer */}
+        {DEFAULT_CLUSTERS.map((c) => {
+          const grad = c.tier === 'high' ? 'url(#heat-high)' : c.tier === 'medium' ? 'url(#heat-med)' : 'url(#heat-low)'
+          const r = c.tier === 'high' ? 14 : c.tier === 'medium' ? 11 : 8
+          return (
+            <g key={`heat-${c.id}`}>
+              <circle cx={c.x} cy={c.y} r={r} fill={grad} filter="url(#glow-blur)" />
+              <circle cx={c.x} cy={c.y} r={r * 0.6} fill={grad} />
+            </g>
+          )
+        })}
+
+        {/* Pin Markers */}
+        {DEFAULT_CLUSTERS.map((c) => {
+          const isSel = selected?.id === c.id
+          const color = c.tier === 'high' ? 'var(--cmp-bad)' : c.tier === 'medium' ? 'var(--cmp-warn)' : 'var(--cmp-ok)'
+          return (
+            <g key={`pin-${c.id}`} onClick={() => handlePick(c)} className="cursor-pointer transition-transform duration-200">
+              {isSel && (
+                <circle cx={c.x} cy={c.y} r={4.5} fill="none" stroke={color} strokeWidth="0.8" opacity="0.8">
+                  <animate attributeName="r" values="3;6;3" dur="2s" repeatCount="indefinite" />
+                  <animate attributeName="opacity" values="0.8;0.2;0.8" dur="2s" repeatCount="indefinite" />
+                </circle>
+              )}
+              <circle cx={c.x} cy={c.y} r={isSel ? 3 : 2.2} fill={color} stroke="#fff" strokeWidth="0.8" />
+              <circle cx={c.x} cy={c.y} r={8} fill="transparent" />
+            </g>
+          )
+        })}
+      </svg>
+
+      {/* Interactive Tooltip Card for Selected Cluster */}
+      {selected && (
+        <div className="mt-2 flex items-center justify-between rounded-xl bg-surface/95 px-3 py-2 text-xs shadow-sm backdrop-blur">
+          <div className="flex items-center gap-2">
+            <span
+              className={`h-2.5 w-2.5 rounded-full ${
+                selected.tier === 'high' ? 'bg-bad-base' : selected.tier === 'medium' ? 'bg-warn-base' : 'bg-ok-base'
+              }`}
+            />
+            <div>
+              <p className="font-semibold text-ink-900">{selected.name}</p>
+              <p className="text-2xs text-ink-500">{selected.state}</p>
+            </div>
+          </div>
+          <span className="font-display font-semibold text-ink-800 tnum">{selected.violations} violations</span>
+        </div>
+      )}
+    </div>
+  )
+}
